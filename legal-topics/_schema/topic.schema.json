{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "china-law-verified/topic.schema.json",
  "type": "object",
  "required": ["topic", "documents", "documents_related", "case_collections", "cases", "cases_related", "statistics", "verification", "known_gaps", "update_state"],
  "properties": {
    "topic": {"$ref": "#/definitions/topic"},
    "documents": {"type": "array", "items": {"$ref": "#/definitions/document"}},
    "documents_related": {"type": "array", "items": {"$ref": "#/definitions/document"}},
    "case_collections": {"type": "array"},
    "cases": {"type": "array", "items": {"$ref": "#/definitions/case"}},
    "cases_related": {"type": "array", "items": {"$ref": "#/definitions/case"}},
    "statistics": {"type": "object"},
    "verification": {"type": "object"},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "update_state": {"type": "object"}
  },
  "definitions": {
    "topic": {
      "type": "object",
      "required": ["id", "title", "primary_law", "schema_version", "topic_status"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "primary_law": {"type": "string"},
        "primary_document_id": {"type": ["string", "null"]},
        "schema_version": {"const": "V4"},
        "topic_status": {"type": "string"}
      }
    },
    "document": {
      "type": "object",
      "required": ["document_id", "title", "document_type", "verification_status", "legal_status", "relation_strength"],
      "properties": {
        "document_id": {"type": "string"},
        "title": {"type": "string"},
        "document_type": {"type": "string"},
        "verification_status": {"enum": ["VERIFIED", "OFFICIAL_META", "CANDIDATE", "UNVERIFIED"]},
        "legal_status": {"enum": ["effective", "repealed", "replaced", "historical", "draft", "pending_verification", "not_applicable"]},
        "relation_strength": {"enum": ["core", "direct", "related", "pending_relation"]}
      }
    },
    "case": {
      "type": "object",
      "required": ["case_id", "case_title", "case_authority", "reference_status", "verification_status", "relation_strength"],
      "properties": {
        "case_id": {"type": "string"},
        "case_title": {"type": "string"},
        "case_authority": {"enum": ["guiding_case", "people_court_database_case", "gazette_case", "typical_case"]},
        "reference_status": {"enum": ["active", "no_longer_reference", "historical", "pending_verification"]},
        "verification_status": {"enum": ["VERIFIED", "OFFICIAL_META", "CANDIDATE", "UNVERIFIED"]},
        "relation_strength": {"enum": ["core", "direct", "related", "pending_relation"]}
      }
    }
  }
}
